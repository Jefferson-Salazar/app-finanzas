<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F4F7F6">

    <!-- Encabezado con botón de regresar, título y botones de acción rápida -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp"
        android:layout_marginTop="16dp">

        <ImageButton
            android:id="@+id/btnRegresarHistorial"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Regresar" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Historial"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:ellipsize="end"/>

        <!-- Botón Seleccionar Todo (Arriba a la derecha, inicialmente oculto) -->
        <ImageButton
            android:id="@+id/btnSeleccionarTodo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_agenda"
            android:visibility="gone"
            android:contentDescription="Seleccionar todo" />

        <!-- Botón Eliminar Seleccionados (Arriba a la derecha, inicialmente oculto) -->
        <ImageButton
            android:id="@+id/btnEliminarSeleccionados"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            android:visibility="gone"
            android:contentDescription="Eliminar seleccionados" />
    </LinearLayout>

    <!-- Filtro -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Filtrar por tipo"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#334155"
        android:layout_marginBottom="6dp"/>

    <Spinner
        android:id="@+id/spinnerFiltro"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="16dp"/>

    <!-- Lista de Transacciones -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerHistorial"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- TextView para mostrar cuando no haya elementos -->
    <TextView
        android:id="@+id/tvHistorialVacio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="No hay movimientos registrados"
        android:textColor="#94A3B8"
        android:textSize="16sp"
        android:textStyle="italic"
        android:visibility="gone"
        android:layout_marginTop="32dp"/>


</LinearLayout>