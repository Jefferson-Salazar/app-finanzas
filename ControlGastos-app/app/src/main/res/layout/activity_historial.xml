<?xml version="1.0" encoding="utf-8"?>
<!-- Contenedor vertical principal que organiza toda la pantalla del historial -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/colorBackground">

    <!-- Encabezado superior con título, botón de retorno y botones de acción múltiple -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="8dp">

        <!-- Tarjeta contenedora para el botón de regresar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/colorSurface"
            app:strokeColor="#2694A3B8"
            app:strokeWidth="1dp">

            <ImageButton
                android:id="@+id/btnRegresarHistorial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="11dp"
                android:background="?attr/selectableItemBackground"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/colorOnSurface"
                android:contentDescription="Regresar" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Bloque de textos del encabezado -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Historial"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnSurface"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tus movimientos"
                android:textSize="13sp"
                android:textColor="@color/colorSecondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Botones de acciones rápidas (Seleccionar todo y Eliminar), inicialmente ocultos -->
        <ImageButton
            android:id="@+id/btnSeleccionarTodo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_agenda"
            app:tint="@color/colorOnSurface"
            android:visibility="gone"
            android:contentDescription="Seleccionar todo" />

        <ImageButton
            android:id="@+id/btnEliminarSeleccionados"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/colorOnSurface"
            android:visibility="gone"
            android:contentDescription="Eliminar seleccionados" />
    </LinearLayout>

    <!-- Sección de etiqueta y Spinner de filtrado -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Filtrar por tipo"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/colorSecondary"
        android:layout_marginTop="16dp"
        android:layout_marginStart="28dp"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/colorSurface"
        app:strokeColor="#2694A3B8"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Menú desplegable (Spinner) para filtrar entre Todos, Ingresos o Gastos -->
            <Spinner
                android:id="@+id/spinnerFiltro"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:paddingStart="8dp"
                android:paddingEnd="44dp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="16dp"
                android:src="@android:drawable/arrow_down_float"
                app:tint="@color/colorSecondary"
                android:importantForAccessibility="no" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Contenedor dinámico que comparte espacio entre la lista y el mensaje de vacío -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- RecyclerView encargado de listar las transacciones eficientemente -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerHistorial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp"
            android:overScrollMode="never" />

        <!-- Mensaje de texto informativo que se muestra únicamente si la lista está vacía -->
        <TextView
            android:id="@+id/tvHistorialVacio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:gravity="center"
            android:text="No hay movimientos registrados"
            android:textColor="#94A3B8"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>