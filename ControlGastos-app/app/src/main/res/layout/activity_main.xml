<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp"
    android:paddingTop="56dp"
    android:background="#F4F7F6">

    <!-- Encabezado -->
    <TextView
        android:id="@+id/tvBienvenida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gestión Financiera"
        android:textColor="#2C3E50"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSubtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resumen Financiero"
        android:textSize="14sp"
        android:textColor="#7F8C8D"
        android:layout_marginBottom="20dp" />

    <!-- Tarjeta del Balance General -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="20dp"
        android:elevation="4dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Balance General"
            android:textSize="14sp"
            android:textColor="#7F8C8D" />

        <TextView
            android:id="@+id/tvBalanceTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Q 0.00"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#27AE60"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Fila de Ingresos y Gastos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <!-- Tarjeta Ingresos -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingresos"
                android:textSize="12sp"
                android:textColor="#7F8C8D" />

            <TextView
                android:id="@+id/tvIngresosTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Q 0.00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#27AE60"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Tarjeta Gastos -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gastos"
                android:textSize="12sp"
                android:textColor="#7F8C8D" />

            <TextView
                android:id="@+id/tvGastosTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Q 0.00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#E74C3C"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Botón para Registrar Movimiento -->
    <Button
        android:id="@+id/btnNuevoMovimiento"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:backgroundTint="#27AE60"
        android:text="+ Registrar Movimiento"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerTransacciones"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp" />

</LinearLayout>