<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp"
    android:paddingTop="56dp"
    android:background="#F4F7F6">

    <!-- Encabezado con Título y Botón Ojo de Privacidad -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBienvenida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gestión Financiera"
                android:textColor="#2C3E50"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resumen Financiero"
                android:textSize="14sp"
                android:textColor="#7F8C8D" />
        </LinearLayout>

        <!-- Botón Ojo para Ocultar / Mostrar Montos -->
        <ImageButton
            android:id="@+id/btnOcultarSaldo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_view"
            android:contentDescription="Ocultar o mostrar saldo" />
    </LinearLayout>

    <!-- Tarjeta del Balance General -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="20dp"
        android:elevation="4dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Balance General"
            android:textSize="14sp"
            android:textColor="#7F8C8D" />

        <TextView
            android:id="@+id/tvBalanceTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Q 0.00"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#27AE60"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Fila de Ingresos y Gastos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <!-- Tarjeta Ingresos -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingresos"
                android:textSize="12sp"
                android:textColor="#7F8C8D" />

            <TextView
                android:id="@+id/tvIngresosTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Q 0.00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#27AE60"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Tarjeta Gastos -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gastos"
                android:textSize="12sp"
                android:textColor="#7F8C8D" />

            <TextView
                android:id="@+id/tvGastosTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Q 0.00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#E74C3C"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Fila con los Dos Botones Directos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnRegistrarIngreso"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#27AE60"
            android:text="Ingreso"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRegistrarGasto"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="#E74C3C"
            android:text="Gasto"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Botón para Ver Historial -->
    <Button
        android:id="@+id/btnVerHistorial"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:backgroundTint="#34495E"
        android:text="Ver Historial de Movimientos"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnRegistrarseMain"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#2980B9"
        android:text="Registrarse"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>