<?xml version="1.0" encoding="utf-8"?>
<!-- Contenedor principal vertical que organiza toda la pantalla del formulario -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/colorBackground">

    <!-- Encabezado superior con botón de retorno y títulos dinámicos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="8dp">

        <!-- Tarjeta contenedora para el botón de regresar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/colorSurface"
            app:strokeColor="#2694A3B8"
            app:strokeWidth="1dp">

            <ImageButton
                android:id="@+id/btnRegresarFormulario"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="11dp"
                android:background="?attr/selectableItemBackground"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/colorOnSurface"
                android:contentDescription="Regresar" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Bloque de textos informativos del título -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/tvTituloFormulario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Movimiento"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnSurface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registra los detalles"
                android:textSize="13sp"
                android:textColor="@color/colorSecondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Contenedor con desplazamiento (Scroll) para campos largos y pantallas pequeñas -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">

        <!-- Contenedor interno de los campos de entrada -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="16dp">

            <!-- Sección de Categoría -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categoría"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/colorSecondary"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/colorSurface"
                app:strokeColor="#2694A3B8"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Spinner o menú desplegable para elegir categoría -->
                    <Spinner
                        android:id="@+id/spinnerCategoria"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:paddingStart="8dp"
                        android:paddingEnd="44dp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="16dp"
                        android:src="@android:drawable/arrow_down_float"
                        app:tint="@color/colorSecondary"
                        android:importantForAccessibility="no" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sección de Monto -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monto (Q)"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/colorSecondary"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp" />

            <!-- TextInputLayout para dar diseño moderno al campo numérico -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:hintEnabled="false"
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="@color/colorSurface"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxStrokeColor="@color/colorPrimary"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMonto"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:hint="0.00"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:textColor="@color/colorOnSurface"
                    android:textColorHint="#94A3B8"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Sección de Descripción opcional -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descripción (opcional)"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/colorSecondary"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="@color/colorSurface"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxStrokeColor="@color/colorPrimary"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp">

                <!-- Campo de texto multilínea para notas adicionales -->
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:gravity="top|start"
                    android:hint="Notas adicionales"
                    android:inputType="textMultiLine|textCapSentences"
                    android:textColor="@color/colorOnSurface"
                    android:textColorHint="#94A3B8"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Botón principal inferior fijo para guardar o actualizar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGuardarMovimiento"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Guardar Movimiento"
        android:textAllCaps="false"
        android:textColor="@color/colorOnPrimary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/colorPrimary"
        app:cornerRadius="16dp"
        app:elevation="0dp" />

</LinearLayout>