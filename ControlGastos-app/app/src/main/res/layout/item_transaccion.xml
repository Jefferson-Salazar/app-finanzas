<?xml version="1.0" encoding="utf-8"?>
<!-- Contenedor raíz de la tarjeta individual (MaterialCardView) que representa un elemento del historial -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/colorSurface"
    app:strokeColor="#2694A3B8"
    app:strokeWidth="1dp">

    <!-- Contenedor horizontal que organiza el CheckBox, los textos y el monto lado a lado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- Casilla de verificación para selección múltiple (inicialmente oculta con 'gone') -->
        <CheckBox
            android:id="@+id/checkboxSeleccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:focusable="false"
            android:clickable="false"
            android:layout_marginEnd="8dp"
            app:buttonTint="@color/colorPrimary" />

        <!-- Bloque vertical con la información de la transacción (Categoría, Concepto y Fecha) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Texto principal que muestra la categoría (ej. Comida, Salario) -->
            <TextView
                android:id="@+id/tvItemCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnSurface"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Texto secundario con la descripción o notas adicionales del movimiento -->
            <TextView
                android:id="@+id/tvItemConcepto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="14sp"
                android:textColor="@color/colorSecondary"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Texto inferior que muestra la fecha y hora formateada -->
            <TextView
                android:id="@+id/tvItemFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="12sp"
                android:textColor="#94A3B8" />
        </LinearLayout>

        <!-- Etiqueta de texto para mostrar el monto (el color verde o rojo se asigna desde el Adaptador) -->
        <TextView
            android:id="@+id/tvItemMonto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="end"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>