<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F7F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registro de Usuario"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crea tu cuenta local para gestionar tu información con seguridad"
            android:textSize="14sp"
            android:textColor="#64748B"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- Nombre -->
        <EditText
            android:id="@+id/etNombreRegistro"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#FFFFFF"
            android:hint="Nombre *"
            android:textColorHint="#94A3B8"
            android:paddingHorizontal="12dp"
            android:textColor="#1E293B"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"/>

        <!-- Apellido (Opcional) -->
        <EditText
            android:id="@+id/etApellidoRegistro"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#FFFFFF"
            android:hint="Apellido (Opcional)"
            android:textColorHint="#94A3B8"
            android:paddingHorizontal="12dp"
            android:textColor="#1E293B"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"/>

        <!-- PIN (Con ojito para mostrar/ocultar) -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            app:passwordToggleEnabled="true"
            app:hintEnabled="false">

            <EditText
                android:id="@+id/etPinRegistro"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#FFFFFF"
                android:hint="PIN (4 dígitos) *"
                android:textColorHint="#94A3B8"
                android:paddingHorizontal="12dp"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:textColor="#1E293B"
                android:textSize="16sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Confirmar PIN (Con ojito para mostrar/ocultar) -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            app:passwordToggleEnabled="true"
            app:hintEnabled="false">

            <EditText
                android:id="@+id/etConfirmarPinRegistro"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#FFFFFF"
                android:hint="Confirmar PIN *"
                android:textColorHint="#94A3B8"
                android:paddingHorizontal="12dp"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:textColor="#1E293B"
                android:textSize="16sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botón Guardar Registro -->
        <Button
            android:id="@+id/btnCompletarRegistro"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#27AE60"
            android:text="Completar Registro"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>