<?xml version="1.0" encoding="utf-8"?>
<!-- ScrollView como contenedor principal para permitir desplazamiento vertical en formularios largos -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none"
    android:overScrollMode="never"
    android:background="@color/colorBackground">

    <!-- LinearLayout vertical interno con márgenes y espaciados simétricos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- Encabezado superior: Título de bienvenida y botón para cerrar la pantalla -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registro de Usuario"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Crea tu cuenta local para gestionar tu información con seguridad"
                    android:textSize="14sp"
                    android:textColor="@color/colorSecondary"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Tarjeta circular contenedora del botón de cancelar o cerrar -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/colorSurface"
                app:strokeColor="#2694A3B8"
                app:strokeWidth="1dp">

                <ImageButton
                    android:id="@+id/btnCerrarRegistro"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="11dp"
                    android:background="?attr/selectableItemBackground"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@color/colorOnSurface"
                    android:contentDescription="Cerrar registro" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Campo de entrada para el Nombre del usuario -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:hintEnabled="false"
            app:boxBackgroundMode="outline"
            app:boxBackgroundColor="@color/colorSurface"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxStrokeColor="@color/colorPrimary"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNombreRegistro"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:hint="Nombre *"
                android:textColorHint="#94A3B8"
                android:inputType="textVisiblePassword"
                android:maxLines="1"
                android:textColor="@color/colorOnSurface"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo de entrada para el Apellido (opcional) -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:hintEnabled="false"
            app:boxBackgroundMode="outline"
            app:boxBackgroundColor="@color/colorSurface"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxStrokeColor="@color/colorPrimary"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etApellidoRegistro"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:hint="Apellido (Opcional)"
                android:textColorHint="#94A3B8"
                android:inputType="textVisiblePassword"
                android:maxLines="1"
                android:textColor="@color/colorOnSurface"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo de entrada para configurar el PIN de seguridad -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:hintEnabled="false"
            app:boxBackgroundMode="outline"
            app:boxBackgroundColor="@color/colorSurface"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxStrokeColor="@color/colorPrimary"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/colorSecondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPinRegistro"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:hint="PIN (4 dígitos) *"
                android:textColorHint="#94A3B8"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:letterSpacing="0.2"
                android:maxLines="1"
                android:textColor="@color/colorOnSurface"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo de entrada para confirmar el PIN de seguridad -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:hintEnabled="false"
            app:boxBackgroundMode="outline"
            app:boxBackgroundColor="@color/colorSurface"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxStrokeColor="@color/colorPrimary"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/colorSecondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirmarPinRegistro"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:hint="Confirmar PIN *"
                android:textColorHint="#94A3B8"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:letterSpacing="0.2"
                android:maxLines="1"
                android:textColor="@color/colorOnSurface"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botón principal para completar el registro y guardar credenciales -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCompletarRegistro"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Completar Registro"
            android:textAllCaps="false"
            android:textColor="@color/colorOnPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/colorPrimary"
            app:cornerRadius="16dp"
            app:elevation="0dp" />

    </LinearLayout>
</ScrollView>